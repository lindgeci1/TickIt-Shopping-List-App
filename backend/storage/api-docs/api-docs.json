{
    "openapi": "3.0.0",
    "info": {
        "title": "My API",
        "description": "This is the API documentation for my app",
        "contact": {
            "email": "support@example.com"
        },
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://127.0.0.1:8000",
            "description": "Default Server"
        }
    ],
    "paths": {
        "/api/person/all": {
            "get": {
                "tags": [
                    "Person"
                ],
                "summary": "Get all people",
                "operationId": "f0162007c0b7870b52c5a1f779d5efdb",
                "responses": {
                    "200": {
                        "description": "List of people",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/PersonDto"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/person/{PersonID}": {
            "get": {
                "tags": [
                    "Person"
                ],
                "summary": "Get a person by PersonID",
                "operationId": "2eeaa5223a5d5fcf5ffcaf915c0091c0",
                "parameters": [
                    {
                        "name": "PersonID",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Person found",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PersonDto"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Person not found"
                    }
                }
            }
        },
        "/api/person/create": {
            "post": {
                "tags": [
                    "Person"
                ],
                "summary": "Create a new person",
                "operationId": "366b2183c6839f05905742f730f6cfc1",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/PersonDto"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Created person",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PersonDto"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/person/update/{PersonID}": {
            "put": {
                "tags": [
                    "Person"
                ],
                "summary": "Update a person",
                "operationId": "419abd90bd81ba577388b385be94b3f0",
                "parameters": [
                    {
                        "name": "PersonID",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/PersonDto"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Updated person",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/PersonDto"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Validation error"
                    },
                    "404": {
                        "description": "Person not found"
                    }
                }
            }
        },
        "/api/person/delete/{PersonID}": {
            "delete": {
                "tags": [
                    "Person"
                ],
                "summary": "Delete a person",
                "operationId": "4ad78cebf6b564fd8431851403114cec",
                "parameters": [
                    {
                        "name": "PersonID",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Person deleted"
                    },
                    "404": {
                        "description": "Person not found"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "PersonDto": {
                "required": [
                    "name",
                    "email"
                ],
                "properties": {
                    "PersonID": {
                        "type": "integer",
                        "nullable": true
                    },
                    "name": {
                        "type": "string"
                    },
                    "email": {
                        "type": "string"
                    },
                    "phone": {
                        "type": "integer",
                        "nullable": true
                    }
                },
                "type": "object"
            }
        }
    },
    "tags": [
        {
            "name": "Person",
            "description": "API Endpoints for Persons"
        }
    ]
}