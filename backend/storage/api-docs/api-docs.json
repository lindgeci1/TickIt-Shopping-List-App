                    },
                    "Name": {
                        "type": "string"
                    },
                    "Location": {
                        "type": "string",
                        "nullable": true
                    },
                    "Products": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                },
                "type": "object"
