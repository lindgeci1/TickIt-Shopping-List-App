        "/api/product-market/assign/{ProductID}": {
            "post": {
                "tags": [
                    "ProductMarket"
                ],
                "summary": "Attach a product to selected markets dynamically",
                "operationId": "87c2265a7303a9d2252c21247915fdb4",
                "parameters": [
                    {
                        "name": "ProductID",
                        "in": "path",
                        "description": "ID of the product to assign markets to",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "properties": {
                                    "market_ids": {
                                        "description": "Array of market IDs selected by the user",
                                        "type": "array",
                                        "items": {
                                            "type": "integer"
                                        }
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Product successfully assigned to markets",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "success": {
                                            "type": "boolean",
                                            "example": true
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Validation error"
                    },
                    "404": {
                        "description": "Product not found"
                    }
                }
            }
        }
