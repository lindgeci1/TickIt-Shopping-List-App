    "components": {
        "schemas": {
            "Assign_Markets_To_Product_DTO": {
                "required": [
                    "ProductID",
                    "MarketIDs"
                ],
                "properties": {
                    "ProductID": {
                        "type": "integer"
                    },
                    "MarketIDs": {
                        "description": "Array of market IDs to assign",
                        "type": "array",
                        "items": {
                            "type": "integer"
                        }
                    }
                },
                "type": "object"
            },
            "Market_DTO": {
                "required": [
                    "Name"
                ],
                "properties": {
                    "MarketID": {
                        "type": "integer",
                        "nullable": true
                    },
                    "Name": {
                        "type": "string"
                    },
                    "Location": {
                        "type": "string",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "Product_DTO": {
                "required": [
                    "Name",
                    "Category"
                ],
                "properties": {
                    "ProductID": {
                        "type": "integer",
                        "nullable": true
                    },
                    "Name": {
                        "type": "string"
                    },
                    "Description": {
                        "type": "string",
                        "nullable": true
                    },
                    "Price": {
                        "type": "number",
                        "format": "float",
                        "nullable": true
                    },
                    "IsFavorite": {
                        "type": "boolean"
                    },
                    "Category": {
                        "type": "string"
                    }
                },
                "type": "object"
            },
            "Shopping_List_Item_DTO": {
                "required": [
                    "ProductID",
                    "Status"
                ],
                "properties": {
                    "Shopping_List_ItemID": {
                        "type": "integer",
                        "nullable": true
                    },
                    "ProductID": {
                        "type": "integer"
                    },
                    "Status": {
                        "type": "string",
                        "enum": [
                            "ToBuy",
                            "Bought"
                        ]
                    },
                    "AddedAt": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    },
                    "BoughtAt": {
                        "type": "string",
                        "format": "date-time",
                        "nullable": true
                    }
                },
                "type": "object"
            }
        }
